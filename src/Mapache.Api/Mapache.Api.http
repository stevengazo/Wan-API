@host = http://localhost:5238
@token = pegar-aquí-el-accessToken-del-login

POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "admin@mapache.local", "password": "cambiar-esto" }

###

GET {{host}}/api/extensions
Authorization: Bearer {{token}}

###

POST {{host}}/api/extensions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Recepción",
  "sipServer": "sip.ejemplo.com",
  "sipUsername": "100",
  "sipPassword": "cambiar-esto",
  "transport": "Udp",
  "answerMode": "Bot"
}
