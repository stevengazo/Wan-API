# Copiar a .env (no se commitea). docker-compose.yml lo carga para el contenedor de la API.
# Formato .NET: "__" separa secciones. Para dotnet run local usar user-secrets (ver README).

# openssl rand -base64 48
Auth__Jwt__SigningKey=
# Admin que se crea en el primer arranque si la base no tiene usuarios.
Auth__BootstrapAdmin__Email=admin@mapache.local
Auth__BootstrapAdmin__Password=

# Bearer token que se configura como secreto en los server tools del agente. openssl rand -hex 32
AgentWebhooks__ToolToken=
# Secreto HMAC del webhook post-llamada (lo genera ElevenLabs al crear el webhook).
AgentWebhooks__PostCallSecret=

# Motor SIP: con false no se registra ninguna cuenta (desarrollo sin red SIP).
Sip__Enabled=true
